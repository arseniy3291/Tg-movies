{
  "name": "cinegram-apps",
  "private": true,
  "version": "1.0.0",
  "description": "Standalone CineGram apps",
  "scripts": {
    "prepare:backend": "node scripts/prepare.cjs",
    "desktop": "npm run prepare:backend && electron desktop/main.cjs",
    "build:mac": "npm run prepare:backend && electron-builder --config desktop/builder.json --mac",
    "build:win": "npm run prepare:backend && electron-builder --config desktop/builder.json --win",
    "prepare:android": "node scripts/prepare.cjs android",
    "prepare:ios": "node scripts/prepare-ios.cjs"
  },
  "dependencies": {
    "axios": "1.13.6",
    "cheerio": "1.2.0",
    "cors": "2.8.6",
    "express": "5.2.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "sharp": "0.34.5"
  }
}
